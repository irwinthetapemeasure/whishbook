# Copy to .env and fill in. Keep .env private (it is git-ignored).

# Random secret for signing logins. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# From Cloudflare Zero Trust > Networks > Tunnels > your tunnel > install connector.
TUNNEL_TOKEN=

# Cloudflare Turnstile ("I'm human" check). Strongly recommended.
# Cloudflare dashboard > Turnstile > Add widget (your hostname, Managed mode).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Owner of the ./data folder on the NAS (run `id` on the NAS).
PUID=1000
PGID=1000

# Optional
# SESSION_DAYS=30
# BACKUP_KEEP=14
